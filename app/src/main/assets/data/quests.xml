<?xml version="1.0" encoding="utf-8"?>
<!--
    Квесты игры.

    Картинки quests/<id>.webp необязательны, файлов пока нет: без картинки на карточке
    показывается иконка квестов.

    <quest id kind="player|random" title progress="true|false" min-balance="N" start="<id узла>"
           image repeatable="true|false" cooldown-minutes="N" stage-delay-minutes="N">
        <description>Описание квеста</description>
        <node id delay-minutes="N" image>
            <text>Описание ситуации</text>
            <option label="Надпись на кнопке" next="<id узла>|end" money="±N" progress="±N">
                <result>Что случилось после выбора</result>
                <effect stat="health|hunger|pleasure" value="±N" />
            </option>
        </node>
    </quest>

    min-balance не тратится при взятии квеста. delay-minutes — через сколько реальных минут
    после выбора станет доступен следующий узел; когда его нет у узла, берётся
    stage-delay-minutes квеста (по умолчанию 0). image — путь относительно assets/textures/,
    необязателен. Надпись на кнопке — не длиннее 16 символов.

    repeatable (по умолчанию true) — можно ли брать квест снова после того, как он пройден; у
    "false" это разово, пока взрослый не включит его заново. cooldown-minutes (по умолчанию 60) —
    сколько реальных минут ждать после прохождения повторяемого квеста, прежде чем его можно
    начать снова.
-->
<quests>
    <quest id="picnic" title="Пикник" kind="player" progress="true" min-balance="300"
           start="store" image="quests/picnic.webp">
        <description>Позови друзей на пикник! Чем лучше подготовка, тем веселее праздник.</description>
        <node id="store">
            <text>Где закупимся продуктами на пикник?</text>
            <option label="Гипермаркет" next="food_set" money="0" progress="20">
                <result>Отличный выбор! В гипермаркете лучшие цены и большой выбор.</result>
                <effect stat="pleasure" value="10" />
                <effect stat="hunger" value="10" />
            </option>
            <option label="Рынок" next="food_set" money="-50" progress="15">
                <result>Продукты свежие и полезные, но вышло накладно.</result>
                <effect stat="health" value="15" />
                <effect stat="pleasure" value="5" />
            </option>
            <option label="Доставка" next="food_set" money="-80" progress="10">
                <result>Удобно, но пришлось заплатить за курьера.</result>
                <effect stat="pleasure" value="5" />
            </option>
        </node>
        <node id="food_set">
            <text>Какой набор продуктов брать?</text>
            <option label="Мясо на шашлык" next="home_items" money="-40" progress="20">
                <result>Сочный шашлык — классика пикника! Все будут сыты.</result>
                <effect stat="hunger" value="25" />
                <effect stat="pleasure" value="15" />
            </option>
            <option label="Овощи" next="home_items" money="0" progress="20">
                <result>Свежие овощи и зелень — полезно, вкусно и не дорого!</result>
                <effect stat="hunger" value="15" />
                <effect stat="health" value="10" />
            </option>
            <option label="Деликатесы" next="home_items" money="-90" progress="15">
                <result>Очень вкусно и изысканно, но деликатесы влетели в копеечку.</result>
                <effect stat="hunger" value="15" />
                <effect stat="pleasure" value="25" />
            </option>
        </node>
        <node id="home_items">
            <text>Что взять из дома?</text>
            <option label="Плед" next="extra_items" money="0" progress="20">
                <result>Мягкий плед сделает отдых на траве уютным и приятным!</result>
                <effect stat="pleasure" value="15" />
            </option>
            <option label="Спички" next="extra_items" money="0" progress="20">
                <result>Спички пригодились, чтобы легко развести костёр.</result>
                <effect stat="pleasure" value="10" />
            </option>
            <option label="Шкаф" next="extra_items" money="0" progress="5">
                <result>Тащить тяжеленный шкаф было плохой идеей... Все устали.</result>
                <effect stat="pleasure" value="-15" />
            </option>
        </node>
        <node id="extra_items">
            <text>Что купить дополнительно?</text>
            <option label="Палатка" next="transport" money="-60" progress="20">
                <result>В палатке можно укрыться и спокойно поесть в уюте!</result>
                <effect stat="pleasure" value="20" />
                <effect stat="hunger" value="10" />
            </option>
            <option label="Посуда" next="transport" money="-20" progress="15">
                <result>Одноразовая посуда пригодилась для удобного обеда.</result>
                <effect stat="hunger" value="15" />
            </option>
            <option label="Игрушка" next="transport" money="-30" progress="10">
                <result>Игрушка порадовала, но сытость убывает — животик урчит.</result>
                <effect stat="pleasure" value="15" />
                <effect stat="hunger" value="-10" />
            </option>
            <option label="Ничего" next="transport" money="0" progress="5">
                <result>Решили ничего не докупать и сэкономить монеты.</result>
            </option>
        </node>
        <node id="transport">
            <text>На чём добираться до места пикника?</text>
            <option label="Электричка" next="end" money="-10" progress="20">
                <result>Поездка на электричке оказалась весёлым приключением!</result>
                <effect stat="pleasure" value="20" />
            </option>
            <option label="Такси" next="end" money="-70" progress="10">
                <result>Быстро доехали, но такси стоило очень дорого.</result>
                <effect stat="pleasure" value="5" />
            </option>
            <option label="Пешком" next="end" money="0" progress="15">
                <result>Прогулялись пешком бесплатно и с пользой для здоровья.</result>
                <effect stat="pleasure" value="10" />
                <effect stat="hunger" value="-5" />
            </option>
        </node>
    </quest>

    <quest id="piggy_bank" title="Копилка" kind="player" start="gift" cooldown-minutes="180"
           image="quests/piggy_bank.webp">
        <description>Научись откладывать: терпение приносит монеты.</description>
        <node id="gift" delay-minutes="2">
            <text>Бабушка подарила монетки. Потратить сразу или отложить?</text>
            <option label="В копилку" next="wait">
                <result>Монетки звякнули в копилке. Подождём!</result>
            </option>
            <option label="На мороженое" next="end">
                <result>Вкусно! Но подарок уже съеден.</result>
                <effect stat="pleasure" value="10" />
                <effect stat="hunger" value="5" />
            </option>
        </node>
        <node id="wait">
            <text>Копилка потяжелела. Что дальше?</text>
            <option label="Открыть" next="end" money="20">
                <result>Внутри 20 монет. Отложенное не пропало!</result>
            </option>
            <option label="Копить дальше" next="end" money="40">
                <result>Бабушка похвалила и добавила. Всего 40 монет!</result>
                <effect stat="pleasure" value="10" />
            </option>
        </node>
    </quest>

    <quest id="lost_wallet" title="Потерянный кошелёк" kind="random" start="found"
           image="quests/lost_wallet.webp">
        <description>На дорожке лежит чужой кошелёк.</description>
        <node id="found">
            <text>Внутри 30 монет и визитка хозяина. Как поступить?</text>
            <option label="Вернуть" next="end" money="20">
                <result>Хозяин сказал спасибо и дал 20 монет. На душе светло!</result>
                <effect stat="pleasure" value="15" />
            </option>
            <option label="Оставить себе" next="end" money="30">
                <result>Монет стало больше, а радости нет: хозяин ищет кошелёк.</result>
                <effect stat="pleasure" value="-20" />
            </option>
        </node>
    </quest>

    <quest id="guests" title="Гости" kind="random" progress="true" start="treat"
           image="quests/guests.webp">
        <description>Скоро придут гости. Подготовься к встрече!</description>
        <node id="treat" delay-minutes="2">
            <text>Чем угостим гостей?</text>
            <option label="Испечь пирог" next="tidy" money="-10" progress="50">
                <result>Пирог удался, дома пахнет выпечкой.</result>
                <effect stat="hunger" value="10" />
            </option>
            <option label="Купить торт" next="tidy" money="-30" progress="40">
                <result>Торт красивый, но дорогой.</result>
                <effect stat="pleasure" value="5" />
            </option>
            <option label="Позвать на чай" next="tidy" progress="10">
                <result>Чай с вареньем и разговоры. Скромно, зато тепло и бесплатно.</result>
                <effect stat="pleasure" value="5" />
            </option>
        </node>
        <node id="tidy">
            <text>Гости уже в пути. Дома порядок?</text>
            <option label="Прибраться" next="end" progress="50">
                <result>Чисто и уютно. Гостям понравилось!</result>
                <effect stat="health" value="5" />
            </option>
            <option label="И так сойдёт" next="end" progress="10">
                <result>Гость споткнулся об игрушку. Неловко вышло.</result>
                <effect stat="pleasure" value="-10" />
            </option>
        </node>
    </quest>

    <quest id="lemonade" title="Лимонад" kind="player" progress="true" min-balance="50"
           start="recipe" image="quests/lemonade.webp" cooldown-minutes="120">
        <description>Открой лимонадный киоск! Выбери рецепт и цену, чтобы заработать монеты.</description>
        <node id="recipe" delay-minutes="1">
            <text>Из чего приготовишь лимонад?</text>
            <option label="Свежие лимоны" next="price" money="-30" progress="50">
                <result>Лимонад получился очень вкусным! Все хотят попробовать.</result>
                <effect stat="pleasure" value="10" />
            </option>
            <option label="Лимонный сок" next="price" money="-15" progress="30">
                <result>Быстро и недорого. Вкус обычный, но освежает.</result>
                <effect stat="pleasure" value="5" />
            </option>
            <option label="Просто вода" next="price" money="0" progress="10">
                <result>Бесплатно, но покупатели ждут настоящий лимонад.</result>
                <effect stat="pleasure" value="-5" />
            </option>
        </node>
        <node id="price">
            <text>Какую цену поставишь за стакан?</text>
            <option label="Честную цену" next="end" money="50" progress="50">
                <result>Отличная цена! Всё быстро разошлось, ты в плюсе.</result>
                <effect stat="pleasure" value="15" />
                <effect stat="hunger" value="-5" />
            </option>
            <option label="Низкую цену" next="end" money="35" progress="40">
                <result>Очередь выстроилась мгновенно! Разобрали всё.</result>
                <effect stat="pleasure" value="10" />
            </option>
            <option label="Завышенную" next="end" money="20" progress="20">
                <result>Слишком дорого: купили всего пару стаканов.</result>
                <effect stat="pleasure" value="-5" />
            </option>
        </node>
    </quest>

    <quest id="fair" title="Ярмарка" kind="random" start="entrance"
           image="quests/fair.webp" cooldown-minutes="120">
        <description>В городе открылась ярмарка! Пойдём посмотрим?</description>
        <node id="entrance" delay-minutes="1">
            <text>На ярмарке столько всего интересного! Куда пойдём?</text>
            <option label="К аттракционам" next="attractions" money="-20">
                <result>Билет стоит 20 монет. Покатаемся на карусели!</result>
                <effect stat="pleasure" value="20" />
            </option>
            <option label="Смотреть фокусы" next="end">
                <result>Представление бесплатное и очень весёлое!</result>
                <effect stat="pleasure" value="10" />
            </option>
            <option label="Помочь с уборкой" next="end" money="25">
                <result>Организаторы отблагодарили за помощь деньгами!</result>
                <effect stat="pleasure" value="5" />
                <effect stat="hunger" value="-5" />
            </option>
        </node>
        <node id="attractions">
            <text>После аттракционов захотелось перекусить.</text>
            <option label="Купить яблоко" next="end" money="-10">
                <result>Сочное яблоко дало сил и хорошего настроения.</result>
                <effect stat="hunger" value="15" />
                <effect stat="health" value="5" />
            </option>
            <option label="Попить воды" next="end">
                <result>Вода из фонтанчика бесплатная и освежает.</result>
                <effect stat="hunger" value="5" />
            </option>
        </node>
    </quest>
</quests>
